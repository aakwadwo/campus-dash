# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase ---------------------------------------------------------------
# Local dev values are printed by `npm run db:start` (supabase start).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security. Never import into client code,
# never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Adapters ---------------------------------------------------------------
# "fake" logs SMS (including phone OTPs) to the server console.
SMS_PROVIDER=fake

# "fake" simulates a ~2s async collection, then succeeds.
PAYMENT_PROVIDER=fake

# NOTE: SEND_SMS_HOOK_SECRET does NOT belong here — it goes in `.env`, because
# the Supabase CLI reads only `.env` (it has no --env-file flag) and needs it to
# resolve env() in config.toml. Next.js reads both files. See docs/AUTH.md.
#   echo "v1,whsec_$(openssl rand -base64 32)" >> .env

# --- Pricing (server-authoritative; the client never supplies these) ---------
# Integer pesewas. 1 GHS = 100 pesewas.
PLATFORM_SERVICE_FEE_PESEWAS=200
PARTNER_DELIVERY_FEE_PESEWAS=500
