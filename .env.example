# Campus Dash — environment
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# keys. See docs/SETUP.md for local setup and docs/HOSTED-SUPABASE.md for
# pointing the app at a hosted Supabase project.
#
# NOTE: fees and timeouts are NOT environment variables. They live in the
# pricing_config table so an admin can change them during the pilot without a
# deploy — see /admin/pilot and docs/OPERATIONS.md.

# --- Supabase ---------------------------------------------------------------
# The project ORIGIN, with no path. Not the REST endpoint: the client libraries
# append /rest/v1, /auth/v1 and /storage/v1 themselves.
#
#   hosted  https://<project-ref>.supabase.co
#   local   http://127.0.0.1:54321          (printed by `npm run db:start`)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key — dashboard: Project Settings → API Keys. Starts sb_publishable_
# on a new project; older projects issue a JWT and call it the anon key, which is
# the same slot and is still accepted under NEXT_PUBLIC_SUPABASE_ANON_KEY.
#
# Safe to expose. Every query it makes is subject to Row Level Security, and
# clients hold SELECT only — every write goes through a SECURITY DEFINER
# function.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Bypasses Row Level Security entirely. Never import it into client
# code, never give it a NEXT_PUBLIC_ prefix, never paste it into a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Adapters ---------------------------------------------------------------
# "fake"    — prints every SMS, including phone OTPs, to the server console and
#             to /dev/inbox. Costs nothing and needs no account.
# "arkesel" — the real Ghana provider. Spends real credit on every message.
SMS_PROVIDER=fake

# "fake"     — simulates a ~2s asynchronous collection, then succeeds. Costs
#              nothing and needs no account.
# "paystack" — real Paystack, hosted redirect checkout, GHS. With TEST keys it
#              spends nothing; with LIVE keys it moves real money.
PAYMENT_PROVIDER=fake

# --- Supabase Auth Send SMS Hook ---------------------------------------------
# SERVER ONLY. From the Supabase dashboard → Authentication → Hooks → Send SMS
# Hook. Must match the dashboard exactly: it is the only thing standing between
# /api/auth/hooks/send-sms and an open SMS-sending endpoint.
#
# Plural, and space-separate two values during a rotation — both are accepted.
# Only needed for a HOSTED project; the local CLI reads its own copy from `.env`.
SEND_SMS_HOOK_SECRETS=

# --- Arkesel (only needed when SMS_PROVIDER=arkesel) -------------------------
# See docs/SMS.md for where each of these comes from and how to test them.

# SERVER ONLY. A bearer credential for an account with real money in it —
# anyone holding it can send SMS at your cost. Never give it a NEXT_PUBLIC_
# prefix and never paste it into a browser.
ARKESEL_API_KEY=

# The sender name recipients see. Must be registered with Arkesel and is capped
# at 11 characters. Not a secret, but not hard-coded either — it differs
# between a test sender and a live one.
ARKESEL_SENDER_ID=

# SERVER ONLY. Verifies that a delivery report really came from Arkesel. Without
# it, anyone who finds the callback URL can write into the notification log.
ARKESEL_WEBHOOK_SECRET=

# Optional. Defaults to https://sms.arkesel.com/sms/api — set only to point at a
# sandbox.
# ARKESEL_SMS_URL=

# Which canonical form Arkesel signs. Their documentation does not state it, so
# it is configurable rather than guessed at. Default: timestamp.body:hex.
# Others: timestamp.body:base64, body:hex, body:base64. See docs/SMS.md.
# ARKESEL_WEBHOOK_SCHEME=

# --- Paystack (only needed when PAYMENT_PROVIDER=paystack) -------------------
# Dashboard → Settings → API Keys & Webhooks. TEST keys start sk_test_ /
# pk_test_; LIVE keys start sk_live_ / pk_live_. See docs/PAYMENTS.md.

# SERVER ONLY, and the most dangerous credential in this file. It charges cards,
# it sends transfers, and it is the key Paystack SIGNS webhooks with — so anyone
# holding it can forge an event that marks an order paid. Never give it a
# NEXT_PUBLIC_ prefix and never paste it into a browser.
PAYSTACK_SECRET_KEY=

# Also server-only, deliberately. It is not a secret, but hosted redirect
# checkout means the browser never talks to Paystack directly, so nothing
# client-side needs it. A NEXT_PUBLIC_ copy would only invite an inline flow
# that skips the server.
PAYSTACK_PUBLIC_KEY=

# Optional. Defaults to https://api.paystack.co — set only to point at a proxy.
# PAYSTACK_API_URL=

# Whether this deployment may push money OUT. Defaults to false, and stays false
# until the Paystack balance is funded, transfers are approved on the account,
# and payout destinations have been checked by a person. While it is off,
# settlement records each payout FAILED with the reason and releases what is
# owed back into the next run — nothing is silently lost.
# PAYSTACK_TRANSFERS_ENABLED=false

# --- Public origin -----------------------------------------------------------
# Where this deployment is reachable. Two callers, two consequences if it is
# missing:
#
#   Arkesel  — builds the delivery-report URL. Sending still works; you simply
#              never learn whether a message arrived.
#   Paystack — builds the checkout return URL (/payment/callback). Without it
#              Paystack falls back to the callback set on the dashboard, which
#              for a preview deployment is the wrong origin entirely. Set it.
# PUBLIC_APP_URL=https://your-deployment.example

# --- Optional: direct database access ---------------------------------------
# Only needed by the maintenance scripts (schema install, admin bootstrap,
# schema snapshot). The application itself never uses it.
#
# Hosted: dashboard → Connect → Session pooler. Contains the database password,
# so treat it exactly like the service-role key.
# SUPABASE_DB_URL=

# ============================================================================
# The following belong in `.env`, NOT here — and only for LOCAL development
# ============================================================================
# The Supabase CLI reads only `.env` from the project root (it has no
# --env-file flag) and needs these to resolve env() in supabase/config.toml.
# Next.js reads both files, so `.env` is the one place a value can be shared.
#
# A hosted project needs NEITHER: its Send SMS Hook is configured in the
# dashboard, not in config.toml. See docs/HOSTED-SUPABASE.md.
#
#   # Signs every Send SMS Hook request (Standard Webhooks HMAC). Must be
#   # base64 after the whsec_ prefix — the verifier decodes it.
#   #   echo "v1,whsec_$(openssl rand -base64 32)" >> .env
#   SEND_SMS_HOOK_SECRET=
#
#   # Placeholder only. GoTrue gates phone login behind an SMS provider block,
#   # but the Send SMS Hook intercepts delivery, so this is never used.
#   SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=unused-hook-handles-delivery
