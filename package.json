{
  "name": "campus-dash",
  "version": "0.1.0",
  "private": true,
  "description": "Campus Dash \u2014 campus-only ordering and delivery for Academic City University, Ghana",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:status": "supabase status",
    "test": "node --test --test-concurrency=1 --env-file-if-exists=.env --env-file-if-exists=.env.local \"tests/**/*.test.js\"",
    "test:watch": "node --test --test-concurrency=1 --env-file-if-exists=.env --env-file-if-exists=.env.local --watch \"tests/**/*.test.js\"",
    "seed:orders": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-orders.mjs",
    "seed:documents": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-partner-documents.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3"
  }
}
